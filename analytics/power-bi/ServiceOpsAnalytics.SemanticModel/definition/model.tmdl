model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PostgreSQLHost","PostgreSQLDatabase","Ticket Performance","Calendar"]

ref table 'Ticket Performance'
ref table Calendar
