{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serviceops.local/contracts/ticket-prediction-completed-v1.json",
  "title": "Ticket Prediction Completed Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "ticketId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "ticket.prediction-completed" },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "ticketId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "priority", "confidence", "modelVersion"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["ACCESS", "BILLING", "DELIVERY", "TECHNICAL"]
        },
        "priority": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "modelVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
