  },
  "description": "ServiceOps golden signals, availability SLO, alert state, logs, and distributed traces.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Prometheus alerts",
      "type": "link",
      "url": "http://localhost:9090/alerts"
    },
    {
      "icon": "doc",
      "includeVars": false,
